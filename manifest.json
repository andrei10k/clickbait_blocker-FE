{
  "manifest_version": 3,
  "name": "ClickBait Blocker",
  "icons": {
    "16": "image/icon16.png",
    "48": "image/icon48.png",
    "128": "image/icon128.png"
  },
  "action": {
    "default_icon": "image/large-icon.png",
    "default_popup": "view/popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "identity",
    "identity.email",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "version": "0.0.31",
  "background": {
    "service_worker": "js/build/background.js"
  },
  "key": "",
  "oauth2": {
    "client_id": "561917015943-b2vga0cl2gv2io7u5hag74clnamfaihf.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/js/jquery-2.2.4.min.js", "js/build/content.js"],
      "css": ["css/style.css"]
    }
  ],
  "options_ui": {
    "page": "view/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["image/*.png", "image/*.gif", "image/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}